# Copy this file to ".env" (same folder as server.js) and fill in ONE of the two options. Restart the server afterwards.
# Real WhatsApp messages are sent automatically when someone presses SOS. No WhatsApp window opens.

# --- Option A: Twilio WhatsApp (quickest to test: Twilio Console > Messaging > Try it out > Send a WhatsApp message) ---
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=your_auth_token
# TWILIO_WA_FROM=+14155238886

# --- Option B: Meta WhatsApp Cloud API (developers.facebook.com > WhatsApp > API setup) ---
# WA_TOKEN=your_permanent_access_token
# WA_PHONE_ID=your_phone_number_id
# WA_TEMPLATE=care_sos_alert          (an approved template with 4 text variables: name, type, place, link. Needed for people who have not messaged you first)
# WA_TEMPLATE_LANG=en

# Country code added to numbers saved without one (default 91 = India)
# WA_DEFAULT_CC=91
# The address your contacts' phones can open (their tracking link). localhost only works on your own computer.
# PUBLIC_URL=https://your-site.example
